# Dev workflow (separate `npm run dev` here + in server/, two ports):
VITE_API_BASE_URL=http://localhost:4000

# Consolidated workflow (server/ serves this build itself, one port/process)
# use an empty value instead, so requests are same-origin relative paths:
# VITE_API_BASE_URL=
# See .env.production.example and README.md.

# Optional: load Pyodide (Python runtime) from a self-hosted copy of the
# pyodide dist instead of the jsDelivr CDN (see docs/operations.md).
# VITE_PYODIDE_BASE_URL=/pyodide/v0.28.0/full/

# Optional: load WebLLM model weights and compiled .wasm model libraries from
# a campus/self-hosted mirror instead of Hugging Face / GitHub raw.
# If hosted on another origin, add that origin to CSP_EXTRA_SOURCES and serve
# CORS + Cross-Origin-Resource-Policy: cross-origin headers (see docs/operations.md).
# VITE_WEBLLM_MODEL_BASE_URL=https://mirror.example.ac.jp/webllm/models/
# VITE_WEBLLM_WASM_BASE_URL=https://mirror.example.ac.jp/webllm/wasm/
