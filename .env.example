# Dev workflow (separate `npm run dev` here + in server/, two ports):
VITE_API_BASE_URL=http://localhost:4000

# Consolidated workflow (server/ serves this build itself, one port/process)
# use an empty value instead, so requests are same-origin relative paths:
# VITE_API_BASE_URL=
# See .env.production.example and README.md.

# Optional: load Pyodide (Python runtime) from a self-hosted copy of the
# pyodide dist instead of the jsDelivr CDN (see docs/operations.md).
# VITE_PYODIDE_BASE_URL=/pyodide/v0.28.0/full/
