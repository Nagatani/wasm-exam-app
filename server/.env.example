DATABASE_URL=postgresql://wasm_exam:wasm_exam@localhost:5433/wasm_exam
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Sandboxed Java judge (docker-compose `judge` service). Server-side compile
# and run for Java submissions goes here; C still runs in the student's
# browser. Leave JUDGE_URL empty to disable Java execution entirely (the
# student UI then shows Java as "準備中").
JUDGE_URL=http://localhost:4001
# Max Java run/compile requests the server will have in flight at once.
JUDGE_CONCURRENCY=3
# Per-request timeout (ms) for a whole /run call to the judge (all test cases).
JUDGE_REQUEST_TIMEOUT_MS=60000

# Where teacher-uploaded task-statement images are written/served from
# (POST /api/uploads). Optional — defaults to server/uploads, created
# automatically. Only override if you need them somewhere else on disk.
# UPLOADS_DIR=
