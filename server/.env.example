DATABASE_URL=postgresql://wasm_exam:wasm_exam@localhost:5433/wasm_exam
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Sandboxed Java judge (docker-compose `judge` service). Server-side compile
# and run for Java submissions goes here; C still runs in the student's
# browser. Leave JUDGE_URL empty to disable Java execution entirely (the
# student UI then shows Java as "準備中").
JUDGE_URL=http://localhost:4001
# Max Java run/compile requests the server will have in flight at once.
JUDGE_CONCURRENCY=3
# Per-request timeout (ms) for a whole /run call to the judge (all test cases).
JUDGE_REQUEST_TIMEOUT_MS=60000

# Where teacher-uploaded task-statement images are written/served from
# (POST /api/uploads). Optional — defaults to server/uploads, created
# automatically. Only override if you need them somewhere else on disk.
# UPLOADS_DIR=

# Self-signup (/signup). Set to false once student accounts are issued from
# the course roster (一括作成) so nobody outside the roster can create one.
# The very first account on an empty DB (the bootstrap teacher) is always
# allowed. Default: true.
# ALLOW_SIGNUP=false

# Login brute-force protection (in-memory, per server process). After
# LOGIN_MAX_FAILURES failed logins for one 学籍番号 from one IP — or
# LOGIN_MAX_FAILURES_PER_IP from one IP across all accounts (a classroom may
# share one NAT address, so keep this high) — further attempts get 429 for
# LOGIN_LOCKOUT_MINUTES. A teacher's パスワード再発行 lifts the lockout.
# LOGIN_MAX_FAILURES=10
# LOGIN_MAX_FAILURES_PER_IP=100
# LOGIN_LOCKOUT_MINUTES=15

# Expired / revoked login sessions are deleted at startup and then every N
# hours (default 6). 0 disables the cleanup.
# SESSION_CLEANUP_INTERVAL_HOURS=6

# Behind a reverse proxy (nginx etc.), set to the number of proxy hops (usually
# 1) so the client IP is read from X-Forwarded-For. Without it every request
# appears to come from the proxy and the per-IP login limit becomes global.
# TRUST_PROXY=1
