generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

enum Language {
  C
  JAVA
  JS
  TS
  PYTHON
}

enum SubmissionStatus {
  AC
  WA
  CE
  TLE
  MLE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

// How a test case's expected output is compared to the program's stdout.
enum ComparisonMode {
  EXACT // trim the whole string, then exact string match (the original rule)
  TRIM_TRAILING_WS // strip each line's trailing spaces/tabs + trailing blank lines
  IGNORE_BLANK_LINES // TRIM_TRAILING_WS, then drop empty lines entirely
  FLOAT // whitespace-tokenised; numeric tokens compared within `floatTolerance`
}

model User {
  id            String   @id @default(uuid())
  studentNumber String   @unique
  passwordHash  String
  displayName   String
  role          Role     @default(STUDENT)
  createdAt     DateTime @default(now())

  sessions       Session[]
  examsCreated   Exam[]
  submissions    Submission[]
  examAttempts   ExamAttempt[]

  @@map("users")
}

// Server-side session store: possessing the raw token isn't enough to prove
// identity from a DB dump alone, and `revoked` lets a teacher (or the student
// themselves) force an immediate logout without waiting for expiry.
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Exam {
  id               String     @id @default(uuid())
  title            String
  description      String?
  timeLimitMinutes Int
  // How many times a student may take this exam. `null` = unlimited; a
  // positive integer caps it. Default 1 (the historical single-attempt
  // behaviour). Only *submitted* attempts count against the cap.
  maxAttempts      Int?       @default(1)
  // Optional scheduling window. Before `opensAt` a published exam is visible
  // but not startable; after `closesAt` no new attempt may start and any
  // in-progress attempt's effective deadline is clamped to it.
  opensAt          DateTime?
  closesAt         DateTime?
  status           ExamStatus @default(DRAFT)
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  createdBy   User          @relation(fields: [createdById], references: [id])
  tasks       Task[]
  submissions Submission[]
  attempts    ExamAttempt[]

  @@map("exams")
}

// One row per time a student takes this exam. `attemptNumber` is 1-based and
// unique per (exam, student). While `IN_PROGRESS` the student edits per-task
// drafts (`TaskDraft`); on final submit the drafts are graded into immutable
// `Submission` rows, `status` flips to `SUBMITTED`, and `score` / `submittedAt`
// are filled in. `startedAt` is the fixed anchor the countdown and the
// teacher's "所要時間" column compute from — per attempt, so a retake restarts
// the clock. Created explicitly via POST /api/student/exams/:examId/attempts,
// not as a side effect of viewing the exam.
model ExamAttempt {
  id            String        @id @default(uuid())
  examId        String
  studentId     String
  attemptNumber Int           @default(1)
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  // Total across all tasks, set when the attempt is finalized. The student's
  // grade for the exam is the `score` of their latest SUBMITTED attempt.
  score         Int?

  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drafts      TaskDraft[]
  submissions Submission[]

  @@unique([examId, studentId, attemptNumber])
  @@index([examId, studentId])
  @@map("exam_attempts")
}

// In-progress answer for one task within one attempt. Mutable: the student's
// per-task "下書き保存" upserts this. Never graded directly — on final submit
// its `code` (+ metrics) is copied into an immutable `Submission`. Carries the
// same client-reported editor metrics `Submission` does, accumulated across
// the whole time the student spends on the task.
model TaskDraft {
  id               String   @id @default(uuid())
  attemptId        String
  taskId           String
  code             String
  keystrokeCount   Int      @default(0)
  pasteCount       Int      @default(0)
  pastedCharCount  Int      @default(0)
  timeSpentSeconds Int      @default(0)
  updatedAt        DateTime @updatedAt

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task    Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([attemptId, taskId])
  @@index([taskId])
  @@map("task_drafts")
}

model Task {
  id               String  @id @default(uuid())
  examId           String
  order            Int
  title            String
  statementMarkdown String
  // The single language a student must answer this task in — chosen by the
  // problem author. There is no student-side language picker.
  language         Language @default(C)
  starterCode      String?
  points           Int     @default(0)
  // Output-comparison rule for this task's test cases, and the tolerance used
  // when `comparisonMode` is FLOAT (ignored otherwise).
  comparisonMode   ComparisonMode @default(EXACT)
  floatTolerance   Float          @default(0.000001)
  createdAt        DateTime @default(now())

  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  testCases   TestCase[]
  solutions   Solution[]
  submissions Submission[]
  drafts      TaskDraft[]

  @@index([examId])
  @@map("tasks")
}

model TestCase {
  id             String  @id @default(uuid())
  taskId         String
  input          String
  expectedOutput String
  isSample       Boolean @default(false)
  order          Int
  timeLimitMs    Int     @default(2000)
  memoryLimitMb  Int     @default(256)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("test_cases")
}

// Reference/model answer. Only ever returned by teacher-only API routes.
model Solution {
  id       String   @id @default(uuid())
  taskId   String
  language Language
  code     String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, language])
  @@map("solutions")
}

// Immutable once created (enforced in the API layer, not the DB): a
// submission is a record of what a student actually turned in. One row per
// (attempt, task) is created when an attempt is finalized.
model Submission {
  id            String            @id @default(uuid())
  examId        String
  taskId        String
  studentId     String
  // The attempt this submission belongs to. Nullable only for pre-attempt
  // legacy rows; every submission created by the current flow sets it.
  attemptId     String?
  language      Language
  code          String
  results       Json
  overallStatus SubmissionStatus
  score         Int               @default(0)
  submittedAt   DateTime          @default(now())

  // Captured client-side from the Monaco editor over the whole time the
  // student spent on this task, so a teacher can spot answers that were
  // mostly pasted in rather than typed. Self-reported by the browser like
  // `code` itself — not a stronger integrity guarantee than that.
  keystrokeCount  Int @default(0)
  pasteCount      Int @default(0)
  pastedCharCount Int @default(0)

  // Wall-clock seconds from when the student's browser opened this specific
  // task to when they hit submit — also client-reported, same trust level as
  // the fields above.
  timeSpentSeconds Int @default(0)

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempt ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([studentId])
  @@index([attemptId])
  @@map("submissions")
}
