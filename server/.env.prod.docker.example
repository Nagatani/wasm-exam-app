# Env for the `server` container in docker-compose.prod.yml (containerized
# operational deployment). Copy to server/.env.prod.docker (gitignored) and
# fill in real values.
#
# NOT used by a host-run server (`npm start` / `npm run dev`) — that path
# still reads server/.env (copy from server/.env.example). The two exist in
# parallel; docs/operations.md explains when to use which.

# A real, reachable-from-the-server-container PostgreSQL endpoint. Production
# should be a managed PostgreSQL instance — this compose file deliberately has
# no `db` service (see docker-compose.prod.yml's top comment).
DATABASE_URL=postgresql://USER:PASSWORD@your-postgres-host:5432/wasm_exam

PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://exam.example.ac.jp

# JUDGE_URL is set by docker-compose.prod.yml itself (http://judge:8080, the
# Docker-internal service name) and overrides whatever is set here — left out
# on purpose so there's nothing to keep in sync.
JUDGE_CONCURRENCY=3
JUDGE_REQUEST_TIMEOUT_MS=60000

# UPLOADS_DIR is intentionally left unset here too: its default already
# resolves to /app/server/uploads inside this image, which is exactly where
# docker-compose.prod.yml's `uploads:` named volume is mounted — see that
# file's `server.volumes` comment. Don't override unless you also change the
# volume's mount path to match.
