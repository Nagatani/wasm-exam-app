# Use this when building the frontend to be served by server/ itself
# (`npm run build:full && npm start` from the repo root) — same-origin
# relative paths, no host/port to hardcode.
VITE_API_BASE_URL=

# Optional: load Pyodide (Python runtime) from a self-hosted copy of the
# pyodide dist instead of the jsDelivr CDN (see docs/operations.md).
# VITE_PYODIDE_BASE_URL=/pyodide/v0.28.0/full/
