{
  "name": "wasm-exam-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run && npm --prefix server test",
    "test:frontend": "vitest run",
    "test:integration": "npm --prefix server run test:integration",
    "test:judge": "npm --prefix server run test:judge",
    "preview": "vite preview",
    "build:full": "npm run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@monaco-editor/react": "^4.7.0",
    "@wasmer/sdk": "^0.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.1"
  }
}
